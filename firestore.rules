rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions for security validation
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidTimestamp() {
      return request.resource.data.updatedAt == request.time || 
             request.resource.data.createdAt == request.time;
    }

    // User profile access: Locked strictly to the record owner
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isOwner']);
      allow delete: if false; // Disallow user record deletion from client
    }

    // Shop business data: Row-Level Security locked by Shop Owner UID
    match /shops/{shopId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        resource == null ? request.resource.data.ownerUid == request.auth.uid : resource.data.ownerUid == request.auth.uid
      );

      // Sub-collections: sales, inventory, repairs, customers, dues
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && 
          request.resource.data.keys().hasAll(['createdAt', 'updatedAt']);
        allow delete: if isAuthenticated();
      }
    }
    
    // Default deny-all fallback for any unspecified routes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
