{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['email', 'role', 'updatedAt'])"
      }
    },
    "shops": {
      "$shopId": {
        ".read": "auth != null && (data.child('ownerUid').val() == auth.uid || data.child('members').child(auth.uid).exists())",
        ".write": "auth != null && data.child('ownerUid').val() == auth.uid",
        "sales": {
          ".read": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())",
          "$saleId": {
            ".validate": "newData.hasChildren(['totalAmount', 'timestamp', 'sellerId'])"
          }
        },
        "inventory": {
          ".read": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())"
        },
        "repairs": {
          ".read": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('shops').child($shopId).child('ownerUid').val() == auth.uid || root.child('shops').child($shopId).child('members').child(auth.uid).exists())"
        }
      }
    },
    ".read": false,
    ".write": false
  }
}