<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="18dp">

    <!-- Timeline indicator column -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_circle_blue">
            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_white"/>
        </FrameLayout>

        <View
            android:id="@+id/timelineLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="#CBD5E1"/>
    </LinearLayout>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sold to Customer"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvEventDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 Aug 2024"
                android:textColor="#64748B"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvEventDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sold to Muhammad Ali for Rs 185,000"
            android:textColor="#475569"
            android:textSize="12.5sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvEventRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ref: INV-002891"
            android:textColor="#2563EB"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="3dp"/>
    </LinearLayout>
</LinearLayout>
