<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/tvDueSummary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="15sp"
        android:textColor="@color/green_900"/>
    <EditText android:id="@+id/etReceiveAmount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Amount received now *"
        android:inputType="numberDecimal" android:layout_marginTop="10dp"/>
    <Spinner android:id="@+id/spReceiveMethod" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnReceive"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Receive Payment"
        android:backgroundTint="@color/green_800"/>
</LinearLayout>
