<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <EditText android:id="@+id/etExpTitle" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Title * (e.g. September rent)"/>
    <Spinner android:id="@+id/spExpCategory" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etExpAmount" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Amount *"
        android:inputType="numberDecimal" android:layout_marginTop="8dp"/>
    <EditText android:id="@+id/etExpNotes" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Notes" android:layout_marginTop="8dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveExpense"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="Save Expense"
        android:backgroundTint="@color/green_800"/>
</LinearLayout>
