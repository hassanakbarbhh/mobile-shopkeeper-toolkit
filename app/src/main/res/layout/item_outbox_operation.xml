<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="10dp"
    android:background="?android:attr/selectableItemBackground">

    <TextView
        android:id="@+id/tvOpStatusIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textColor="#059669"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginEnd="10dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CREATE_SALE (Invoice #2891)"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvOpTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, 08:41 AM • 0 retries"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvOpBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COMPLETED"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:textColor="#065F46"
        android:background="@drawable/bg_badge_green"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"/>
</LinearLayout>
