<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#EDF2F7"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="iPhone 15 Pro Max"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="#0F172A"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tvUnitPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹120,000 / unit"
                android:textSize="12.5sp"
                android:textColor="#64748B"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Stepper Pill for Quantity with >=48dp touch targets -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_white_10"
            android:backgroundTint="#F1F5F9"
            android:paddingHorizontal="2dp">

            <ImageButton
                android:id="@+id/btnMinus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_remove"
                app:tint="#334155"
                android:contentDescription="Decrease quantity"/>

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="#0F172A"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="#334155"
                android:contentDescription="Increase quantity"/>
        </LinearLayout>

        <!-- Line Total -->
        <TextView
            android:id="@+id/tvLineTotal"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="₹120,000"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/green_800"
            android:layout_marginStart="8dp"/>

        <!-- Delete Item Button (>=48dp touch target) -->
        <ImageButton
            android:id="@+id/btnRemove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:tint="@color/error"
            android:contentDescription="Remove item from cart"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
