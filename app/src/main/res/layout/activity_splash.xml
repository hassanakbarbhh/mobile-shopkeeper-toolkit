<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_green">

    <View
        android:layout_width="340dp"
        android:layout_height="340dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-140dp"
        android:layout_marginEnd="-140dp"
        android:background="@drawable/bg_circle_green"
        android:alpha="0.15"/>

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-110dp"
        android:layout_marginStart="-110dp"
        android:background="@drawable/bg_circle_green"
        android:alpha="0.12"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLogo"
            android:layout_width="130dp"
            android:layout_height="130dp"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/white">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_app_logo"
                    android:contentDescription="App logo"/>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvTitle1"
            style="@style/SplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Mobile Inventory"
            android:textSize="30sp"/>

        <TextView
            android:id="@+id/tvTitle2"
            style="@style/SplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toolkit"
            android:textSize="30sp"
            android:textColor="@color/green_400"/>

        <View
            android:id="@+id/divider"
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:background="@color/green_500"/>

        <TextView
            android:id="@+id/tvMadeBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_white_10"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="@string/made_by"
            android:textColor="@color/green_100"
            android:textSize="14sp"
            android:textStyle="italic"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="36dp">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:trackColor="#33FFFFFF"
            app:indicatorColor="@color/green_400"
            app:trackCornerRadius="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/splash_loading"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/version"
            android:textColor="#66FFFFFF"
            android:textSize="11sp"/>
    </LinearLayout>
</FrameLayout>
