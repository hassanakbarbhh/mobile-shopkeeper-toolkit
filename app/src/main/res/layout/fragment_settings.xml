<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shop Profile (printed on invoices)" android:textStyle="bold"
            android:textColor="@color/green_900"/>
        <EditText android:id="@+id/etShopName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop name" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/etShopPhone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop phone"
            android:inputType="phone" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/etShopAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop address" android:layout_marginTop="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Save Profile"
            android:backgroundTint="@color/green_800"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Currency &amp; Regional" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvCurrentCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR - Pakistani Rupee (Rs)"
                        android:textStyle="bold"
                        android:textColor="@color/green_900"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvCurrencySymbolPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active symbol: Rs (Default: PKR)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCurrency"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <!-- Trending Themes & Appearance Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Trending Themes &amp; Appearance" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvCurrentThemeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Emerald Green (Active)"
                        android:textStyle="bold"
                        android:textColor="@color/green_900"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvCurrentThemeDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="6 Trending Themes • AMOLED Dark Mode"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectTheme"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Themes"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <!-- Database Backup Center -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Secure Database Backup (Google Drive / Local)" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Safely backup your entire shop database to Google Drive or internal storage to prevent data loss."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBackupDatabase"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/green_800"
                android:text="Export Backup"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestoreDatabase"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Import &amp; Restore"
                android:textSize="11sp"
                app:icon="@drawable/ic_import"
                app:iconSize="14dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <!-- Export Center -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Data Export Center (CSV / Excel)" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Export any ledger into Excel/CSV spreadsheets or printable PDF reports with direct sharing."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportInventorySettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Stock / Phones"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportSalesSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Sales Invoices"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCustomersSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Customers"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPurchasesSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Daily Purchases"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportRepairsSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Repairs Ledger"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportMasterLedgerSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Master Shop PDF"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <!-- Data Import & Export -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Data Import &amp; Export"
            android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImportCsvSettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="@color/green_800"
                android:text="Import Data (CSV)"
                android:textSize="11sp"
                app:icon="@drawable/ic_import"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportAllCsvSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Export All (CSV)"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <!-- Thermal Receipt Printer Section -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POS Thermal Receipt Printer (58mm / 80mm)"
            android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestThermalPrint"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Print Sample Sale Receipt"
                android:textSize="11sp"
                app:icon="@drawable/ic_thermal_printer"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestRepairTag"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Print Sample Repair Tag"
                android:textSize="11sp"
                app:icon="@drawable/ic_thermal_printer"
                app:iconSize="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCustomThermalPrint"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Custom Thermal Print"
                android:textSize="11sp"
                app:icon="@drawable/ic_thermal_printer"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThermalCustomOptions"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Header, Footer &amp; Barcode"
                android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaultStock"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clean Customers &amp; Reset All Phones Stock (No Price)"
            android:textColor="@color/green_800"
            app:icon="@drawable/ic_online_phone"
            app:iconSize="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageSellersSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage Shop Sellers &amp; Staff (Owner)"
            app:icon="@drawable/ic_seller"
            app:iconSize="18dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="16dp"/>

        <!-- Google & Firebase Authentication Section -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Google &amp; Firebase Login (100% Free)" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/green_200"
            app:cardBackgroundColor="#F8FAFC">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_google"
                        android:contentDescription="Google"/>

                    <TextView
                        android:id="@+id/tvSettingsGoogleAccount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Google &amp; Firebase Authentication"
                        android:textColor="@color/green_900"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_firebase"
                        android:contentDescription="Firebase"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSettingsGoogleSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🛡️ Verified Google Identity • Anti-Leak Owner Security Active"
                    android:textColor="@color/green_700"
                    android:textSize="11sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManageGoogleAuth"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Manage Google &amp; Firebase Login"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_google"
                    app:iconSize="16dp"
                    app:iconTint="@null"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckFirebaseAuth"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Run Live Firebase &amp; Auth Diagnostics"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_google"
                    app:iconSize="16dp"
                    app:iconTint="@null"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="16dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Role Passwords &amp; Security Keys" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnLockAppNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lock App Now (Test Login Interface)"
            app:icon="@drawable/ic_lock"
            app:iconSize="18dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage Role Keys (Owner, Seller, Tech)"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnSwitchRole"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Switch Role (Owner / Seller / Tech)"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnAbout"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/green_800"
            android:text="About Developer: Hassan Akbar (+923172377565)"
            app:icon="@drawable/ic_seller"
            app:iconSize="18dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="24dp"
            android:text="@string/version" android:textColor="@color/text_secondary" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
