<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Shop Profile (printed on invoices)" android:textStyle="bold"
            android:textColor="@color/green_900"/>
        <EditText android:id="@+id/etShopName" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop name" android:layout_marginTop="8dp"/>
        <EditText android:id="@+id/etShopPhone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop phone"
            android:inputType="phone" android:layout_marginTop="6dp"/>
        <EditText android:id="@+id/etShopAddress" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Shop address" android:layout_marginTop="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Save Profile"
            android:backgroundTint="@color/green_800"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Currency &amp; Regional" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="12dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tvCurrentCurrency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PKR - Pakistani Rupee (Rs)"
                        android:textStyle="bold"
                        android:textColor="@color/green_900"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/tvCurrencySymbolPreview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Active symbol: Rs (Default: PKR)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCurrency"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Change"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GitHub Remote Synchronization" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.shopkeeper.mobileshop.ui.components.SyncStatusIndicatorView
            android:id="@+id/settingsSyncIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSyncSuccess"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Set Synced"
                android:textSize="11sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSyncPending"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Set Pending"
                android:textSize="11sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSyncError"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Set Error"
                android:textSize="11sp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigureRepo"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Configure GitHub Repo &amp; Branch"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <!-- Export Center -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Data Export Center (CSV / Excel)" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Export any ledger into Excel/CSV spreadsheets or printable PDF reports with direct sharing."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportInventorySettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Stock / Phones"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportSalesSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Sales Invoices"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportCustomersSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Customers"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPurchasesSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Daily Purchases"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportRepairsSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Repairs Ledger"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportMasterLedgerSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Master Shop PDF"
                android:textSize="11sp"
                app:icon="@drawable/ic_export"
                app:iconSize="14dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResetDefaultStock"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clean Customers &amp; Reset All Phones Stock (No Price)"
            android:textColor="@color/green_800"
            app:icon="@drawable/ic_online_phone"
            app:iconSize="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageSellersSettings"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage Shop Sellers &amp; Staff (Owner)"
            app:icon="@drawable/ic_seller"
            app:iconSize="18dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="@color/divider" android:layout_marginVertical="18dp"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Security &amp; Account (Key: Hassanisgreat)" android:textStyle="bold"
            android:textColor="@color/green_900"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnLockAppNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Lock App Now (Test Login Interface)"
            app:icon="@drawable/ic_lock"
            app:iconSize="18dp"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnChangePassword"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Change Login Key (Default: Hassanisgreat)"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSwitchRole"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Switch Role (Owner / Repair)"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAbout"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="About Hassan ❤"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:layout_marginTop="24dp"
            android:text="@string/version" android:textColor="@color/text_secondary" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
