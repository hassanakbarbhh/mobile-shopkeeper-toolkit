<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:background="@drawable/bg_gradient_green"
            android:paddingTop="40dp" android:paddingBottom="28dp">
            <androidx.cardview.widget.CardView android:layout_width="110dp"
                android:layout_height="110dp" app:cardCornerRadius="55dp" app:cardElevation="8dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop" android:src="@drawable/hassan_photo"
                    android:contentDescription="Hassan"/>
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="Hassan"
                android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/about_tagline" android:textColor="@color/green_100"
                android:textSize="13sp" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_pill_white_10"
                android:paddingHorizontal="18dp" android:paddingVertical="7dp"
                android:text="@string/about_love" android:textColor="@color/green_100"
                android:textSize="12sp" android:textStyle="italic"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green" android:textColor="@color/green_800"
                android:textStyle="bold" android:textSize="12sp"
                android:paddingHorizontal="14dp" android:paddingVertical="8dp"
                android:text="📱 15+ yrs Mobile Business"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_badge_green" android:textColor="@color/green_800"
                android:textStyle="bold" android:textSize="12sp"
                android:paddingHorizontal="14dp" android:paddingVertical="8dp"
                android:text="💻 10+ yrs Development"/>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Connect with me" android:textStyle="bold" android:textSize="16sp"
            android:textColor="@color/green_900" android:layout_marginStart="20dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnWhatsApp"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="WhatsApp" app:icon="@drawable/ic_whatsapp"
                android:backgroundTint="#25D366" app:cornerRadius="14dp" android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFacebook"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Facebook" app:icon="@drawable/ic_facebook"
                android:backgroundTint="#1877F2" app:cornerRadius="14dp" android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnInstagram"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Instagram" app:icon="@drawable/ic_instagram"
                android:backgroundTint="#E1306C" app:cornerRadius="14dp" android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnYouTube"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="YouTube" app:icon="@drawable/ic_youtube"
                android:backgroundTint="#FF0000" app:cornerRadius="14dp" android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Email" app:icon="@drawable/ic_email"
                android:backgroundTint="@color/green_800" app:cornerRadius="14dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:layout_marginTop="20dp"
                android:text="@string/version" android:textColor="@color/text_secondary" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
