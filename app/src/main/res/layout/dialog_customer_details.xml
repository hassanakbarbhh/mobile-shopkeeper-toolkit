<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Customer Identity Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvDetailInitials"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_circle_green"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ali Khan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:id="@+id/tvDetailPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+92 300 1234567"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Outstanding Balance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FED7AA"
            app:cardBackgroundColor="#FFF7ED">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Outstanding Balance (Khata)"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:textColor="#C2410C"/>

                    <TextView
                        android:id="@+id/tvDetailOutstanding"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="₹0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#9A3412"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailReceivePayment"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Receive"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#9A3412"
                    android:backgroundTint="#FED7AA"
                    app:cornerRadius="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Action Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailCall"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Call"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_800"
                app:icon="@drawable/ic_call"
                app:iconTint="@color/green_800"
                app:iconSize="16dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailWhatsApp"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="WhatsApp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_800"
                app:icon="@drawable/ic_whatsapp"
                app:iconTint="@color/green_800"
                app:iconSize="16dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailNewSale"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="New Sale"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_800"
                app:icon="@drawable/ic_add_sale"
                app:iconTint="@color/green_800"
                app:iconSize="16dp"
                app:cornerRadius="12dp"/>
        </LinearLayout>

        <!-- Transaction History Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recent Transactions &amp; Invoices"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"/>

        <!-- Transactions Container -->
        <LinearLayout
            android:id="@+id/layoutCustomerTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/tvNoTransactions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No purchase invoices on record yet"
            android:textSize="12.5sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:visibility="gone"/>

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Edit Info"
                android:textColor="@color/green_800"
                android:textSize="12sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailClose"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Close"
                android:textColor="#64748B"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
